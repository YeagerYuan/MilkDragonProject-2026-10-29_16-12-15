    - id: 2e3ba0772cb4491880438d3d678aae7b
      title: "\u53A8\u623F\u4FBF\u7B3A"
      text: "\u4ED6\u4E0D\u559C\u6B22\u74F6\u5B50\u91CC\u7684\u996E\u6599\uFF0C\u4E5F\u4E0D\u559C\u6B22\u84DD\u8272\u7684\u88C5\u9970\u54C1\u3002\u4ECA\u5929\u7ED9\u4ED6\u51C6\u5907\u7684\u662F\u4E00\u79CD\u7EA2\u8272\u7684\u6C34\u679C\u3002"
      position: {x: -7, y: 0.03, z: -4}
      rotation: {x: 90, y: 0, z: 0}
    - id: c22ed6dc98f946828ed8030cf86aed8c
      title: "\u996E\u98DF\u8BB0\u5F55"
      text: "\u8FD9\u79CD\u6C34\u679C\u957F\u5728\u6811\u4E0A\uFF0C\u5207\u5F00\u540E\u679C\u8089\u504F\u767D\uFF0C\u4E2D\u5FC3\u6709\u51E0\u9897\u5C0F\u7C7D\u3002\u4ED6\u8BF4\u8FD9\u662F\u81EA\u5DF1\u6700\u559C\u6B22\u7684\u98DF\u7269\u3002"
      position: {x: -6, y: 0.03, z: -4}
      rotation: {x: 90, y: 0, z: 0}
    - id: 793a435910484bfa9398b6802d8eef40
      title: "\u6446\u653E\u8BF4\u660E"
      text: "\u628A\u84DD\u8272\u5C0F\u7403\u653E\u5230\u90A3\u5F20\u684C\u817F\u4E0D\u592A\u5408\u7FA4\u7684\u684C\u5B50\u4E0A\uFF0C\u518D\u62CD\u4E00\u5F20\u7167\u7247\u3002"
